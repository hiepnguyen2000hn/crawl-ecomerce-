# ── SerpAPI keys (comma-separated, xoay tự động khi 429) ──────────────────────
SERPAPI_KEYS=key1,key2,key3

# ── Apify ─────────────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_xxx

# ── OpenRouter AI keys (comma-separated, xoay tự động khi 429) ────────────────
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crawl_ecomerce

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false

# ── CloakBrowser ──────────────────────────────────────────────────────────────
# CDP endpoint của cloakserve (Docker service name khi chạy compose)
CLOAK_BROWSER_URL=http://cloakbrowser:9222
# License key từ cloakhq.com (để trống nếu dùng free tier - 1 concurrent session)
CLOAK_LICENSE_KEY=
