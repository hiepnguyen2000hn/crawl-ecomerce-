# SerpAPI — key mặc định (fallback nếu DB không có key nào)
SERPAPI_KEY=your_serpapi_key_here

# Apify — Facebook Ads Library Scraper
APIFY_TOKEN=your_apify_token_here

# OpenRouter — AI analysis (add multiple keys via API at runtime)
# Keys managed via POST /api/v1/ai/keys

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crawl_ecomerce

# App
APP_ENV=development
APP_DEBUG=true

# Provider rotation settings (optional — tunable via code)
# COOLDOWN_MINUTES=10   (key bị 429 thì cooldown bao nhiêu phút)
# PROXY_FAIL_MINUTES=5  (proxy lỗi thì disable bao nhiêu phút)
# MAX_RETRIES=3         (số lần retry tối đa)
