# ── SerpAPI keys (comma-separated, xoay tự động khi 429) ──────────────────────
SERPAPI_KEYS=key1,key2,key3

# ── Apify ─────────────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_xxx
# Trần chi phí MỘT lần chạy actor — vượt là hủy run giữa chừng.
# Không phải phòng xa: một actor được gọi maxItems=10 đã trả 2.693 item, tốn $3.98.
# `maxItems` với nhiều actor chỉ là gợi ý; trần này mới là ràng buộc thật.
APIFY_MAX_COST_PER_RUN_USD=0.50

# ── OpenRouter AI keys (comma-separated, xoay tự động khi 429) ────────────────
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crawl_ecomerce

# ── Redis (arq job queue) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
JOB_TTL_SECONDS=86400

# ── Nhịp crawl (Shopify, Bol.com, Reddit — các connector tự fetch) ────────────
# Bắt đầu chậm rồi nới ra rẻ hơn nhiều so với bị chặn cả dải IP rồi mới hạ.
CRAWL_MIN_DELAY_MS=1500
CRAWL_JITTER_MS=500
CRAWL_TIMEOUT_S=30
# Bỏ trống = dùng UA Chrome mặc định trong app/crawl/http.py
CRAWL_USER_AGENT=

# ── Reddit — SRS Bước 1.4, chỉ số S1.4 ────────────────────────────────────────
# Tạo app kiểu "script" tại https://www.reddit.com/prefs/apps (miễn phí).
# Dùng OAuth app-only; KHÔNG dùng endpoint .json công khai vì nó trả 403 với IP datacenter.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit BẮT BUỘC UA mô tả thật — UA chung chung bị chặn thẳng.
REDDIT_USER_AGENT=levelup-research/0.1 by /u/your_reddit_username

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false

# ── CloakBrowser ──────────────────────────────────────────────────────────────
# CDP endpoint của cloakserve (Docker service name khi chạy compose)
CLOAK_BROWSER_URL=http://cloakbrowser:9222
# License key từ cloakhq.com (để trống nếu dùng free tier - 1 concurrent session)
CLOAK_LICENSE_KEY=
